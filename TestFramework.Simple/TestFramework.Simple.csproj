<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>TestFramework.Simple</Title>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>A wrapper for simple tasks the Timeline should perform. Like C# Actions, MessageBoxes</Description>
		<Version>0.1.6</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Core</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Core.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>Adds Trigger.Message(...), a cross-platform trigger that writes a captioned line to the run log. Prefer it over Trigger.MessageBox(...), which is Windows-only and blocks on a modal dialog - unusable headless or in CI.
MessageBoxTrigger.Invoker is now public and settable so the dialog can be replaced in a test, and setting TESTFRAMEWORK_MESSAGEBOX=off makes it return without showing a dialog. The interactive default is unchanged.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\Modules\TestFramework-Common\Assets\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Simple.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	
	<ItemGroup>
	  <!-- Simple consumes Core as a published package, not as a project. The dependency tree stays
	       explicit: this pin is exactly what the produced nuspec declares, and it is the version a
	       consumer will resolve. Core must therefore be published before Simple ships against it. -->
	  <PackageReference Include="TestFramework.Core" Version="0.1.10" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
