<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>TestFramework.Config</Title>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Config</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Configuration for TestFramework runs: one config instance per run, read by every package through the same reader.</Description>
		<Version>0.4.0</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Core</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Core.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0; add using TestFramework.Config where a step calls context.Configured&lt;T&gt;, and rebuild, because SetupRun(ConfigInstance) gained caller-info parameters. BREAKING - a custom ConfigShape implements Read(values, identifier) and Values(config, identifier), and CreateAsync always disposes the provider it builds. SetupRun(ConfigInstance) now disposes its provider when the run ends, AddConfigShape refuses a second, different shape for a record, and configuration identifiers match exactly, case included.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(PackageIconSourcePath)">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Config.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<!-- Config consumes Core as a published package, not as a project. The dependency tree stays
		     explicit: this pin is exactly what the produced nuspec declares, and it is the version a
		     consumer will resolve. Core must therefore be published before Config ships against it. -->
		<PackageReference Include="TestFramework.Core" Version="0.7.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
