<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both targets: the library multi-targets, so a net10.0-only regression would ship untested. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Simple only, no Core project: Core arrives the way a consumer gets it, as the package Simple pins, so a
         binary break between the two shows up here instead of being papered over by a fresh build of Core. -->
    <ProjectReference Include="..\..\TestFramework.Simple\TestFramework.Simple.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>