<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>TestFramework.Config</Title>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Config</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>An easy to use utility for managing your configs inside the TestFramework timeline.</Description>
		<Version>0.4.0</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-Core</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-Core.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0. The blocking ConfigPersistentEnvironmentContext constructors are removed, and CreateAsync no longer takes disposePersistentServiceProvider: the context always disposes the provider it builds. Configured and CreateRunConfig are now overloads instead of optional parameters, which is source-compatible.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\Modules\TestFramework-Common\Assets\Icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.Config.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<!-- Config consumes Core as a published package, not as a project. The dependency tree stays
		     explicit: this pin is exactly what the produced nuspec declares, and it is the version a
		     consumer will resolve. Core must therefore be published before Config ships against it. -->
		<PackageReference Include="TestFramework.Core" Version="0.7.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
